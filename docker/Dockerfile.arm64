# syntax=docker/dockerfile:1
# Phase 1 — Immutable environment for arm64 (Grace / GH200-class) nodes.
# The official pytorch/pytorch CUDA images are amd64-only; this bakes the
# pinned aarch64 cu128 wheel stack into a registry image so cluster jobs can
# swap their pip bootstrap for this once a registry is available.
FROM --platform=linux/arm64 python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

RUN pip install torch==2.7.1 --index-url https://download.pytorch.org/whl/cu128 \
    && pip install numpy==2.2.6 psutil==7.0.0

WORKDIR /workspace
COPY src/ /workspace/src/

RUN useradd -m -u 1000 trainer
USER trainer

ENTRYPOINT ["python", "src/train_torch.py"]
